# Optional: set to the real public origin before building for production.
# Do not use the old reference site's address for a different deployment.
UVC_SITE_URL=https://uvc-olive.vercel.app

# Studio is CLOSED unless all settings below are valid. Server-side only.
# Register a GitHub OAuth App with callback:
# https://uvc-olive.vercel.app/api/auth/callback/github
NEXTAUTH_URL=https://uvc-olive.vercel.app
# NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
# UVC_STUDIO_GITHUB_CLIENT_ID=
# UVC_STUDIO_GITHUB_CLIENT_SECRET=
# UVC_STUDIO_GITHUB_ID=immutable-numeric-id-of-the-author
