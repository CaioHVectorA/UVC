# Studio uses PostgreSQL. Configure DATABASE_URL on the server (never NEXT_PUBLIC_).
# Local development: use .env.local; hosted production: use Neon/Vercel credentials.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/uvc?sslmode=require

# Public origin used by metadata and sitemap.
UVC_SITE_URL=https://uvc-olive.vercel.app

# Initial login is admin / admin, stored as a salted scrypt hash in PostgreSQL.
# Sessions use random cookies and are stored/revoked in the DB.
# No GitHub OAuth App or NEXTAUTH_SECRET is required by this login.
