{
  "name": "uvc-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "media:prepare": "node scripts/prepare-media.mjs",
    "predev": "npm run validate:content",
    "prebuild": "npm run validate:content",
    "validate:content": "tsx scripts/validate-content.ts",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "format:check": "prettier --check app components lib scripts tests *.ts *.mjs",
    "assets:index": "node scripts/index-studio-assets.mjs",
    "db:init": "tsx --env-file=.env.local scripts/init-studio-db.ts",
    "db:import:marginal": "tsx --env-file=.env.local scripts/import-marginal.ts",
    "db:test": "node scripts/test-db-start.mjs"
  },
  "dependencies": {
    "@tiptap/pm": "^3.32.1",
    "@tiptap/react": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "@xyflow/react": "^12.12.0",
    "clsx": "^2.1.1",
    "domhandler": "^6.0.1",
    "htmlparser2": "^12.0.0",
    "lucide-react": "^0.475.0",
    "mammoth": "^1.13.0",
    "next": "^15.5.28",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.0.1",
    "unpdf": "^2.0.0",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.0.7",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/yauzl": "^3.4.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "jszip": "^3.10.2",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "engines": {
    "node": "24.x"
  }
}
